#pragma once

#if !defined(__@NYX_API@_INSIDE__) && !defined(@NYX_API@_COMPILATION)
#error "This header file can not be included directly."
#endif

#if (defined(_WIN32) || defined(__CYGWIN__)) && !defined(@NYX_API@_STATIC_COMPILATION)
#define _@NYX_API@_EXPORT __declspec(dllexport) extern
#define _@NYX_API@_IMPORT __declspec(dllimport) extern
#elif __GNUC__ >= 4
#define _@NYX_API@_EXPORT __attribute__((visibility("default"))) extern
#define _@NYX_API@_IMPORT extern
#else
#define _@NYX_API@_EXPORT extern
#define _@NYX_API@_IMPORT extern
#endif

#if defined(@NYX_API@_COMPILATION)
#define _@NYX_API@_VISIBILITY _@NYX_API@_EXPORT
#else
#define _@NYX_API@_VISIBILITY _@NYX_API@_IMPORT
#endif

#define @NYX_API@_API                _@NYX_API@_VISIBILITY

#if !defined(NYX_DISABLE_DEPRECATION_WARNINGS)
#define @NYX_API@_DEPRECATED         G_DEPRECATED _@NYX_API@_VISIBILITY
#define @NYX_API@_DEPRECATED_FOR(f)  G_DEPRECATED_FOR(f) _@NYX_API@_VISIBILITY
#else
#define @NYX_API@_DEPRECATED         _@NYX_API@_VISIBILITY
#define @NYX_API@_DEPRECATED_FOR(f)  _@NYX_API@_VISIBILITY
#endif
