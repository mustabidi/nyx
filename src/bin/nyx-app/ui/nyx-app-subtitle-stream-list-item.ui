<?xml version="1.0" encoding="UTF-8"?>
<interface domain="nyx-app">
  <template class="GtkListItem">
    <property name="activatable">false</property>
    <property name="child">
      <object class="AdwPreferencesGroup">
        <binding name="title">
          <closure type="gchararray" function="nyx_app_list_item_make_stream_group_title">
            <lookup name="item">GtkListItem</lookup>
          </closure>
        </binding>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Title</property>
            <binding name="subtitle">
              <lookup name="title" type="NyxStream">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Language</property>
            <binding name="subtitle">
              <lookup name="lang-name" type="NyxSubtitleStream">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
