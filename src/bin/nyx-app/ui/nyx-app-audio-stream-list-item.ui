<?xml version="1.0" encoding="UTF-8"?>
<interface domain="nyx-app">
  <template class="GtkListItem">
    <property name="activatable">false</property>
    <property name="child">
      <object class="AdwPreferencesGroup">
        <binding name="title">
          <closure type="gchararray" function="nyx_app_list_item_make_stream_group_title">
            <lookup name="item">GtkListItem</lookup>
          </closure>
        </binding>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Codec</property>
            <binding name="subtitle">
              <lookup name="codec" type="NyxAudioStream">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Channels</property>
            <binding name="subtitle">
              <closure type="gchararray" function="nyx_app_list_item_convert_int">
                <lookup name="channels" type="NyxAudioStream">
                  <lookup name="item">GtkListItem</lookup>
                </lookup>
              </closure>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Sample Format</property>
            <binding name="subtitle">
              <lookup name="sample-format" type="NyxAudioStream">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Sample Rate</property>
            <binding name="subtitle">
              <closure type="gchararray" function="nyx_app_list_item_convert_int">
                <lookup name="sample-rate" type="NyxAudioStream">
                  <lookup name="item">GtkListItem</lookup>
                </lookup>
              </closure>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Bitrate</property>
            <binding name="subtitle">
              <closure type="gchararray" function="nyx_app_list_item_make_bitrate">
                <lookup name="bitrate" type="NyxAudioStream">
                  <lookup name="item">GtkListItem</lookup>
                </lookup>
              </closure>
            </binding>
          </object>
        </child>
        <child>
          <object class="NyxAppPropertyRow">
            <property name="title" translatable="yes">Language</property>
            <binding name="subtitle">
              <lookup name="lang-name" type="NyxAudioStream">
                <lookup name="item">GtkListItem</lookup>
              </lookup>
            </binding>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
