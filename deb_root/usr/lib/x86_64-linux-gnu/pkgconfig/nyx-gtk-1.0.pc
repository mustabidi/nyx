prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

Name: nyx-gtk
Description: Nyx GTK integration library
Version: 1.1.0
Requires: nyx-1.0, gstreamer-1.0 >=  1.24.0, gtk4 >=  4.10.0, glib-2.0 >=  2.76.0, gobject-2.0 >=  2.76.0
Requires.private: gstreamer-base-1.0 >=  1.24.0, gstreamer-video-1.0 >=  1.24.0, gmodule-2.0 >=  2.76.0, gstreamer-audio-1.0 >=  1.24.0, gstreamer-tag-1.0 >=  1.24.0, gstreamer-pbutils-1.0 >=  1.24.0, gio-2.0 >=  2.76.0, libpeas-2, gio-unix-2.0 >=  2.76.0
Libs: -L${libdir} -lnyx-gtk-1.0
Libs.private: -lm -L${prefix}/lib/x86_64-linux-gnu/gstreamer-1.0 -lgstnyx
Cflags: -I${includedir}/nyx-gtk-1.0
