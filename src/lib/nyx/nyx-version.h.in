#pragma once

#if !defined(__NYX_INSIDE__) && !defined(NYX_COMPILATION)
#error "Only <nyx/nyx.h> can be included directly."
#endif

#include <glib.h>

/**
 * NYX_MAJOR_VERSION:
 *
 * Nyx major version component
 */
#define NYX_MAJOR_VERSION            (@NYX_MAJOR_VERSION@)

/**
 * NYX_MINOR_VERSION:
 *
 * Nyx minor version component
 */
#define NYX_MINOR_VERSION            (@NYX_MINOR_VERSION@)

/**
 * NYX_MICRO_VERSION:
 *
 * Nyx micro version component
 */
#define NYX_MICRO_VERSION            (@NYX_MICRO_VERSION@)

/**
 * NYX_VERSION:
 *
 * Nyx version
 */
#define NYX_VERSION                  (@NYX_VERSION@)

/**
 * NYX_VERSION_S:
 *
 * Nyx version, encoded as a string
 */
#define NYX_VERSION_S                "@NYX_VERSION@"

#define NYX_ENCODE_VERSION(major,minor,micro) \
    ((major) << 24 | (minor) << 16 | (micro) << 8)

/**
 * NYX_VERSION_HEX:
 *
 * Nyx version, encoded as an hexadecimal number, useful for integer comparisons.
 */
#define NYX_VERSION_HEX \
    (NYX_ENCODE_VERSION (NYX_MAJOR_VERSION, NYX_MINOR_VERSION, NYX_MICRO_VERSION))

#define NYX_CHECK_VERSION(major, minor, micro)                           \
    (NYX_MAJOR_VERSION > (major) ||                                      \
    (NYX_MAJOR_VERSION == (major) && NYX_MINOR_VERSION > (minor)) || \
    (NYX_MAJOR_VERSION == (major) && NYX_MINOR_VERSION == (minor) && \
    NYX_MICRO_VERSION >= (micro)))

G_BEGIN_DECLS

guint nyx_get_major_version (void);

guint nyx_get_minor_version (void);

guint nyx_get_micro_version (void);

const gchar * nyx_get_version_s (void);

G_END_DECLS
